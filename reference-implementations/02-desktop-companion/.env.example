# Build #2 config (SPEC §11). Copy to .env. Every knob has a default in
# desktop/config.py; this file shows the ones you'll actually touch.

# --- the brain (Build #1, reused) -------------------------------------------
# Her thinking is yours too (§1). The model id's PREFIX picks the provider — the
# provider seam reads it (app/providers/openrouter.py::_route):
#
#   lm_studio/<model>    → local LM Studio server  (OpenAI-compatible, :1234/v1)
#   ollama/<model>       → local Ollama            (pull first: `ollama pull qwen3:8b`)
#   openrouter/<model>   → hosted OpenRouter        (needs OPENROUTER_API_KEY below)
#   <model>  (no prefix) → assumed OpenRouter       (the openrouter/ prefix is added)
#
# Swapping providers is one change: the CHAT_MODEL prefix (+ the key if hosted).
# Default: a local LM Studio model, fully offline.
CHAT_MODEL=lm_studio/google/gemma-4-12b-qat
UTILITY_MODEL=lm_studio/google/gemma-4-12b-qat
# Other options — comment the two lines above, uncomment one pair:
# CHAT_MODEL=ollama/qwen3:8b
# UTILITY_MODEL=ollama/qwen3:8b
# CHAT_MODEL=openrouter/deepseek/deepseek-v4-flash
# UTILITY_MODEL=openrouter/deepseek/deepseek-v4-flash

# LM Studio's OpenAI-compatible endpoint (only used for lm_studio/… ids).
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Ollama alternative (uses its default http://localhost:11434 endpoint):
# CHAT_MODEL=ollama/qwen3:8b
# UTILITY_MODEL=ollama/qwen3:8b
# EMBED_BACKEND=ollama
# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768

# Needed only when a model above is routed through OpenRouter. Get one at
# openrouter.ai/keys. Left blank, LiteLLM still picks up an OPENROUTER_API_KEY
# exported in your shell.
OPENROUTER_API_KEY=

# Real-time voice: turn the *reply's* <think> pass OFF so a local reasoning model
# (e.g. gemma-4-12b-qat) speaks immediately instead of thinking first — otherwise
# the <think> block eats the whole token budget and the reply comes back empty, or
# seconds late. Inert on a non-reasoning model. (Build #1 keeps it ON for quality.)
CHAT_THINKING=false
# Utility model keeps thinking ON: fact-extraction + summarisation run off the hot
# path (post-turn), so it can afford to reason. Its <think> block needs room before
# the JSON answer, so keep the budget generous — too small truncates the answer.
UTILITY_THINKING=true
UTILITY_MAX_TOKENS=2048

# Embeddings stay LOCAL either way (the mind stays ownable, §3) — independent of
# CHAT_MODEL. Default: the SAME local LM Studio server as the chat model, so one
# process backs both the mind and its memory (load an embedding model in LM Studio
# first). EMBED_DIM MUST equal the model's width and must not change once the Vault
# is indexed (re-run scripts/seed_vault.py if you switch embedders). Alternatives:
#   EMBED_BACKEND=ollama        EMBED_MODEL=nomic-embed-text        EMBED_DIM=768
#   EMBED_BACKEND=sentence_tf   EMBED_MODEL=BAAI/bge-small-en-v1.5  EMBED_DIM=384
EMBED_BACKEND=lm_studio
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
EMBED_DIM=768

# Her own Vault (standalone). Seed it once: `python scripts/seed_vault.py`.
# Her identity is the SOUL (the same card as Build #1); to *continue* a Build #1
# companion instead of starting fresh, point this at that Vault — moving her is
# copying a folder (→ ch. 19; the DoD "same someone", §13).
VAULT_DIR=./vault
SOUL_SRC=./soul-src

HOST=127.0.0.1
PORT=8766

# --- voice: ears / voice / turn-taking (§3) ---------------------------------
STT_BACKEND=faster_whisper        # faster_whisper | fake
STT_MODEL=base.en

# Default voice: Kokoro — CPU, faster-than-real-time, needs no GPU and leaves the
# whole GPU for the LLM + avatar (→ ch. 24). A single fixed voice, but it works out
# of the box on a modest machine (lowest latency of the three). Upgrades: qwen3_tts
# is the "designed" persona voice — a warm, gentle register CLONED from the bundled
# assets/designed.wav so every filler + sentence is one identical voice (re-designing
# per turn drifts); higher quality but slower (leans on the §5 filler masking) and
# needs `pip install -e ".[tts]"` + a CUDA GPU. gpt_sovits clones a canon voice.
TTS_BACKEND=kokoro                 # kokoro (default) | qwen3_tts | gpt_sovits | fake
TTS_REGISTER=default               # kokoro register only
QWEN_MODE=clone                    # clone (stable) | design (re-designs each turn, drifts)
# QWEN_REF_AUDIO=/abs/path/to/voice.wav   # clone your own voice (default: designed.wav)
# QWEN_REF_TEXT=exact transcript of that wav
# QWEN_DEVICE=cuda:0
# GPT-SoVITS (TTS_BACKEND=gpt_sovits): a zero-shot cloner — every request carries
# a reference clip + its exact transcript (the server holds no default voice, so
# omitting them 500s). Defaults reuse the bundled designed.wav, so it works out of
# the box; ref_audio is a path on the SERVER's filesystem. Swap for the canon voice:
# SOVITS_BASE_URL=http://127.0.0.1:9880
# SOVITS_REF_AUDIO=/abs/path/to/canon_voice.wav
# SOVITS_PROMPT_TEXT=exact transcript of that clip
# SOVITS_PROMPT_LANG=en
# SOVITS_TEXT_LANG=en

VAD_BACKEND=silero                 # silero | fake
VAD_THRESHOLD=0.5
# Debounce (SpeechGate, §3.4): consecutive speech frames to confirm a turn. A
# mechanical-keyboard click is a 1–2 frame transient; a sustained run is speech.
# Interrupting her (barge-in) is held to a higher bar than starting a new turn —
# this is the "I type and she stops" fix.
VAD_ONSET_FRAMES=3                  # frames to confirm a new-turn onset
VAD_BARGEIN_FRAMES=5               # frames to confirm a barge-in (stricter)
# Server-side: require the VAD to confirm real speech in an endpointed utterance
# before taking it as a turn. Turn off if a quiet mic/over-strict VAD drops real
# speech (the transcript filter still catches punctuation-only hallucinations).
VAD_CONFIRM=true

# --- the loop (§4–§6) --------------------------------------------------------
MASK_LATENCY=true                  # play a filler while the LLM spins up (§5)
# Reply/greeting ceiling. A roomy cap, not a target — leaves room for a heartfelt
# turn (→ ch. 28) without truncating mid-sentence. A no-think reply stops when it's
# done and rarely nears it. Lower it if you want tighter, more clipped replies.
MAX_REPLY_TOKENS=1600
# High-frequency latency diagnostics retain this file plus one previous generation.
TRACE_MAX_BYTES=2000000

# Which Live2D rig she wears (§6). Install the bodies once with
# `python scripts/fetch_avatar.py`, then swap freely here. miara/kei/ren are the
# prettier, modern female rigs (miara is the safest — Cubism 4; kei/ren are Cubism
# 5 and need a current Cubism Core). hiyori (default) and haru/mao/natori are full
# expressive rigs; mark/rice/wanko are minimal rigs that only lipsync (no
# eye-smile/brow presets). An unknown or un-fetched value falls back to hiyori.
AVATAR_MODEL=miara                 # miara | kei | ren | hiyori | haru | mao | mark | natori | rice | wanko

# Desktop-pet window (`python -m desktop --window`, needs the [desktop] extra):
# a frameless, transparent, always-on-top window that floats just the avatar on
# your desktop. Ignored by the plain browser mode.
WINDOW_WIDTH=360
WINDOW_HEIGHT=640
WINDOW_ON_TOP=true
#WINDOW_GUI=gtk                    # engine override: "" auto (Chromium if installed — crisper) | qt | gtk

# With the local defaults above, nothing here needs a cloud key — pull the network
# cable and she still runs (§1). Point CHAT_MODEL at openrouter/… and only that one
# call leaves the machine; memory, embeddings and voice stay on-device.
