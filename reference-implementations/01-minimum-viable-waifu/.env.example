# Build #1 configuration (SPEC §11). Copy to .env and fill in the key.
# No secrets in code — everything tunable lives here.

# Needed only when a model below is routed through OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# models — LiteLLM router seam (§3.1). The id's PREFIX picks the provider:
#   lm_studio/<model>   → local LM Studio server   (OpenAI-compatible, :1234/v1)
#   ollama/<model>      → local Ollama             (pull first: `ollama pull qwen3:8b`)
#   openrouter/<model>  → hosted OpenRouter        (needs OPENROUTER_API_KEY above)
#   <model> (no prefix) → assumed OpenRouter
# Default: a local LM Studio model. Switch providers by swapping the prefix.
CHAT_MODEL=lm_studio/google/gemma-4-12b-qat
UTILITY_MODEL=lm_studio/google/gemma-4-12b-qat
# Other options — comment the two lines above, uncomment one pair:
# CHAT_MODEL=ollama/qwen3:8b
# UTILITY_MODEL=ollama/qwen3:8b
# CHAT_MODEL=deepseek/deepseek-v4-flash
# UTILITY_MODEL=deepseek/deepseek-v4-flash

# LM Studio's OpenAI-compatible endpoint (only used for lm_studio/… ids).
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# gemma-4-12b-qat is a *reasoning* model — it thinks before it answers. Build #1
# keeps thinking ON (full reply quality) and gives the call token headroom so the
# <think> pass AND the reply both fit; too small a ceiling returns an EMPTY reply.
# For a non-reasoning model these are inert. (Build #2 turns thinking off for speed.)
CHAT_THINKING=true
UTILITY_THINKING=true
MAX_REPLY_TOKENS=2048

# embeddings — local, always (§3: the mind stays ownable)
# EMBED_BACKEND: sentence_tf (pure-Python, no server) | ollama | lm_studio
EMBED_BACKEND=sentence_tf
EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_DIM MUST equal the index vector width
EMBED_DIM=384
# lm_studio instead — reuse the same local LM Studio server as the chat model (no
# Ollama). Load an embedding model in LM Studio first, then (re-seed the Vault when
# switching backends, EMBED_DIM must match the model):
# EMBED_BACKEND=lm_studio
# EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBED_DIM=768

# where to serve (used by `python -m app`)
HOST=127.0.0.1
# PORT picked clear of the local-AI stack (ST 8000, Gradio 7860, Kobold 5001…)
PORT=8765

# the mind
VAULT_DIR=./vault
SOUL_SRC=../yuri-soul
USER_NAME=you

# prompt/memory knobs (§7, §6.4)
RAW_WINDOW_TURNS=6
RETRIEVAL_K=6
RETRIEVAL_MIN_SIM=0.25
HALF_LIFE_DAYS=30
SUMMARY_EVERY_N=8
SUMMARY_BUDGET_TOKENS=300
LOREBOOK_BUDGET_TOKENS=400
SYSTEM_BUDGET_TOKENS=8000
TEMPERATURE=0.9
