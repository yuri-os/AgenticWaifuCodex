{
  "_comment": "Phr00t's Qwen-Rapid-AIO-NSFW (Qwen-Image-Edit merge, distilled + NSFW LoRAs baked in) as a GGUF, run as plain txt2img. Drop-in for the diffusion model only: reuses the same qwen_2.5_vl text encoder + qwen_image VAE as qwen_image_gguf.json. It's a DISTILLED 'Rapid' model — low steps and cfg 1.0 (NOT the base's 30/4.0). %CKPT% names the AIO GGUF in models/diffusion_models (e.g. qwen-rapid-nsfw-v9.0-Q4_K_M.gguf). Step/cfg are %STEPS%/%CFG% tokens (pass via the backend's extra_tokens; defaults baked here are 8 steps @ cfg 1.0, euler_ancestral/beta).",
  "37": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "%CKPT%" }
  },
  "38": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "39": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "66": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "shift": 3.1, "model": ["37", 0] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%POSITIVE%", "clip": ["38", 0] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%NEGATIVE%", "clip": ["38", 0] }
  },
  "58": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": "%WIDTH%", "height": "%HEIGHT%", "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "%SEED%",
      "steps": "%STEPS%",
      "cfg": "%CFG%",
      "sampler_name": "euler_ancestral",
      "scheduler": "beta",
      "denoise": 1.0,
      "model": ["66", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["58", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["39", 0] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "imageforge_qwen_aio", "images": ["8", 0] }
  }
}
